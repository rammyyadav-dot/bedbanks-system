# syntax=docker/dockerfile:1
# One image recipe for the four Next.js apps (ADR 0040). Build context is the repository root:
#   docker build -f Dockerfile.web --build-arg APP=admin --build-arg PACKAGE=@bedbanks/admin-console -t fbeds-admin .
# ADR 0055: agent, admin and supplier are environment-neutral. Their /api/v1 proxy (proxy.ts) reads API_INTERNAL_URL, AUTH_API_ORIGIN, SUPPLIER_ORIGIN and
# AUTH_COOKIE_NAME from the RUNTIME environment, so one image digest is promoted unchanged between environments. Only the website still bakes public,
# non-secret URLs (canonical/SEO) at build time through the NEXT_PUBLIC_* arguments, so a website image serves one environment. Nothing secret may be a build argument.
ARG NODE_IMAGE=node:24-slim@sha256:55fb5f5a527ea2c5c4a95f963e48ef90aa38c7b346054fdc8ee9957a2b55d205
FROM ${NODE_IMAGE} AS build
RUN npm install -g pnpm@10.4.1
WORKDIR /app
ARG APP
ARG PACKAGE
# Public, non-secret build settings used by the website only (canonical URLs, sitemap, portal links).
ARG NEXT_PUBLIC_AGENT_API_URL
ARG NEXT_PUBLIC_SITE_URL
ARG NEXT_PUBLIC_AGENT_URL
ARG NEXT_PUBLIC_ADMIN_URL
ARG NEXT_PUBLIC_SUPPLIER_URL
ARG NEXT_PUBLIC_CONTACT_EMAIL
ENV NEXT_OUTPUT=standalone NEXT_TELEMETRY_DISABLED=1 \
    NEXT_PUBLIC_AGENT_API_URL=$NEXT_PUBLIC_AGENT_API_URL NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL NEXT_PUBLIC_AGENT_URL=$NEXT_PUBLIC_AGENT_URL \
    NEXT_PUBLIC_ADMIN_URL=$NEXT_PUBLIC_ADMIN_URL NEXT_PUBLIC_SUPPLIER_URL=$NEXT_PUBLIC_SUPPLIER_URL NEXT_PUBLIC_CONTACT_EMAIL=$NEXT_PUBLIC_CONTACT_EMAIL
COPY . .
RUN test -n "$APP" && test -n "$PACKAGE" \
  && pnpm install --frozen-lockfile \
  && pnpm exec turbo run build --filter="$PACKAGE" \
  && mkdir -p "apps/$APP/public"

FROM ${NODE_IMAGE} AS run
ARG APP
# The server is a traced standalone bundle run by `node`: it needs no package manager. Removing npm/corepack/yarn (as the API image does) drops the
# vulnerable copies of brace-expansion and undici that npm bundles in its own node_modules, and the tooling an attacker would use post-compromise.
RUN rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack /opt/yarn-* \
      /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack /usr/local/bin/yarn /usr/local/bin/yarnpkg
# PORTAL_HOSTED=1 makes the runtime proxy enforce the hosted rules (HTTPS, non-loopback, exact /api/v1); a container is always hosted.
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORTAL_HOSTED=1 APP_DIR=$APP PORT=3000 HOSTNAME=0.0.0.0
WORKDIR /app
# The standalone tree keeps the monorepo layout: apps/<app>/server.js plus a traced, minimal node_modules.
COPY --from=build --chown=node:node /app/apps/${APP}/.next/standalone ./
COPY --from=build --chown=node:node /app/apps/${APP}/.next/static ./apps/${APP}/.next/static
COPY --from=build --chown=node:node /app/apps/${APP}/public ./apps/${APP}/public
USER node
EXPOSE 3000
CMD ["sh", "-c", "exec node apps/${APP_DIR}/server.js"]
