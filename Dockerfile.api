# FBEDS API container. Build context is the repository root:
#   docker build -f Dockerfile.api -t fbeds-api .
FROM node:24-slim
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/* \
  && npm install -g pnpm@10.4.1
WORKDIR /app
COPY . .
RUN pnpm install --frozen-lockfile \
  && pnpm --filter @bedbanks/api prisma:generate
ENV NODE_ENV=production API_HOST=0.0.0.0
EXPOSE 3002
# Hosts such as Render and Railway inject PORT; the API reads API_PORT.
CMD ["sh", "-c", "API_PORT=\"${PORT:-3002}\" exec pnpm --filter @bedbanks/api start:prod"]
