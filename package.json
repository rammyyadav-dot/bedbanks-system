{
  "name": "bedbanks-system",
  "private": true,
  "packageManager": "pnpm@10.4.1",
  "engines": {
    "node": "24.x",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "set -a; [ ! -f /vercel/share/.env.project ] || . /vercel/share/.env.project; set +a; (cd apps/api && env -u API_PORT -u ADMIN_ORIGIN API_PORT=3002 ADMIN_ORIGIN=http://localhost:3000 pnpm dev) & api_pid=$!; NEXT_PUBLIC_AGENT_API_URL=http://localhost:3002/api/v1 pnpm --dir apps/agent dev; agent_status=$?; kill $api_pid 2>/dev/null || true; wait $api_pid 2>/dev/null || true; exit $agent_status",
    "build": "turbo run build",
    "type-check": "turbo run type-check",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "check:contracts": "node --import tsx tools/contract-check.ts",
    "check:app-boundaries": "node --import tsx tools/app-boundary-check.ts",
    "check:no-float": "node --import tsx tools/no-float-check.ts",
    "check:no-silent-fallback": "node --import tsx tools/no-silent-fallback-check.ts",
    "check:ledger-single-writer": "node --import tsx tools/ledger-single-writer-check.ts",
    "check:tenant-filter": "node --import tsx tools/tenant-filter-check.ts",
    "check:schema": "node --import tsx tools/no-divergent-schema-check.ts",
    "check:public-env": "node --import tsx tools/public-env-check.ts",
    "check:runtime-db-role": "node --import tsx tools/runtime-db-role-check.ts",
    "check:aws-governance": "node tools/aws-governance-check.mjs",
    "golive:preflight": "node tools/aws-golive-preflight.mjs",
    "check:architecture": "pnpm check:contracts && pnpm check:app-boundaries && pnpm check:no-float && pnpm check:no-silent-fallback && pnpm check:ledger-single-writer && pnpm check:tenant-filter && pnpm check:public-env && pnpm check:runtime-db-role && pnpm check:aws-governance && pnpm check:workflow-permissions && pnpm check:framework-peers",
    "check:workflow-permissions": "node tools/workflow-permissions-check.mjs",
    "check:framework-peers": "node tools/framework-peer-check.mjs",
    "check:dependencies": "node tools/dependency-audit-check.mjs"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@prisma/client": "^6.2.1",
    "eslint": "^10.13.0",
    "prisma": "^6.2.1",
    "tsx": "^4.23.15",
    "turbo": "^2.11.9",
    "typescript-eslint": "^8.71.2"
  },
  "pnpm": {
    "overrides": {
      "multer": "^2.4.0",
      "lodash": "^4.18.1",
      "js-yaml@^4": "^4.3.2",
      "js-yaml@^5": "^5.4.1",
      "deepmerge-ts@^7": "^8.0.2",
      "sharp": "^0.35.5",
      "source-map-js": "^1.2.2",
      "proxy-addr": "^2.0.8"
    }
  }
}
