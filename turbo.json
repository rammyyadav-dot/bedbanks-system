{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "**/package.json",
    "**/tsconfig.json",
    ".env",
    "tools/deployment/**",
    "**/.env.local",
    "**/.env.production",
    "**/.env.production.local"
  ],
  "globalEnv": [
    "NODE_ENV"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "env": [
        "API_INTERNAL_URL",
        "AUTH_API_ORIGIN",
        "AUTH_COOKIE_NAME",
        "VERCEL",
        "SUPPLIER_ORIGIN",
        "NEXT_PUBLIC_AGENT_API_URL",
        "NEXT_PUBLIC_SITE_URL",
        "NEXT_PUBLIC_AGENT_URL",
        "NEXT_PUBLIC_ADMIN_URL",
        "NEXT_PUBLIC_SUPPLIER_URL",
        "NEXT_PUBLIC_CONTACT_EMAIL",
        "VERCEL_PROJECT_PRODUCTION_URL",
        "VERCEL_URL"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**",
        "build/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": []
    },
    "type-check": {
      "outputs": []
    },
    "test": {
      "outputs": [
        "coverage/**"
      ]
    },
    "test:watch": {
      "cache": false,
      "persistent": true
    }
  }
}
