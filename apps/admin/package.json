{
  "name": "@bedbanks/admin-console",
  "version": "0.1.0",
  "description": "FBEDS — Admin Console (internal ops: tenants, hotels, access, audit)",
  "private": true,
  "packageManager": "pnpm@10.4.1",
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "start": "next start --port 3001",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "theme:tokens": "node --import tsx scripts/generate-theme-tokens.ts",
    "test": "node --import tsx --test lib/*.test.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@bedbanks/contracts": "workspace:*",
    "@bedbanks/ui": "workspace:*",
    "@bedbanks/tracing": "workspace:*",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.300.0",
    "@opentelemetry/id-generator-aws-xray": "3.0.0",
    "@opentelemetry/instrumentation": "0.300.0",
    "@opentelemetry/instrumentation-http": "0.300.0",
    "@opentelemetry/propagator-aws-xray": "3.0.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@opentelemetry/sdk-trace-node": "2.12.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "postcss": "^8.5",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
