# FBEDS Admin Console — environment variables
# Copy this file to apps/admin/.env.local and adjust as needed.
# Never commit .env or .env.local — see .gitignore.

# Server-only API base URL. Browser calls go to the same-origin /api/v1 path and
# are proxied here by next.config rewrites, because the session cookie is
# host-only on the Admin origin. Required in production and on Vercel.
API_INTERNAL_URL=http://localhost:3002/api/v1

# Must exactly match API ADMIN_ORIGIN. The API rejects mutating requests whose
# Origin differs, and server-to-API calls send this value. Required in production.
AUTH_API_ORIGIN=http://localhost:3001

# Must match AUTH_COOKIE_NAME in apps/api/.env (default: fbeds_session).
AUTH_COOKIE_NAME=fbeds_session

# Use HTTPS for the Admin browser URL to support Secure session cookies.
