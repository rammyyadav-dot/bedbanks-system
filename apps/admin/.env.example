# FBEDS Admin Console — environment variables
# Copy this file to apps/admin/.env.local and adjust as needed.
# Never commit .env or .env.local — see .gitignore.

# URL of the running FBEDS API. In development this is localhost.
# In production this is your App Runner / ECS endpoint.
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Must match AUTH_COOKIE_NAME in apps/api/.env (default: fbeds_session).
# The admin middleware reads this cookie to check for a session.
AUTH_COOKIE_NAME=fbeds_session
