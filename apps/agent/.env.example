# FBEDS Agent Portal — environment variables
# Copy this file to apps/agent/.env.local and adjust as needed.
# Never commit .env or .env.local — see .gitignore.

# URL of the running FBEDS API.
# When this is unset or empty, HotelService returns labelled demo data
# (mock mode) so the agent portal is always browsable without a live API.
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
