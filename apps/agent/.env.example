# Server-side URL of the API, including /api/v1. The Agent proxies /api/v1/* here so the
# session cookie stays on the Agent origin. Required on Vercel (the build fails without it).
API_INTERNAL_URL=http://localhost:3002/api/v1
# Optional override of the browser API base (default: same-origin /api/v1). Public value only.
# NEXT_PUBLIC_AGENT_API_URL=/api/v1
