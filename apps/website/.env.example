# fBeds public website. Never place secrets in NEXT_PUBLIC variables.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=hello@fbeds.com

# Independently deployed portal destinations.
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
NEXT_PUBLIC_AGENT_URL=http://localhost:3003
NEXT_PUBLIC_SUPPLIER_URL=http://localhost:3004

# Optional server-only lead receiver. Leave unset until an approved endpoint exists.
FBEDS_LEAD_ENDPOINT_URL=
