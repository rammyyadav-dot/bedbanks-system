# FBEDS Public Website — environment variables
# Copy this file to apps/website/.env.local and adjust as needed.
# The website uses these for subdomain-based portal routing (middleware.ts).

# Root domain for subdomain routing (e.g. yourbedbank.com)
# - portal.<FBEDS_ROOT_DOMAIN>  → agent portal
# - ops.<FBEDS_ROOT_DOMAIN>     → admin console
# - api.<FBEDS_ROOT_DOMAIN>     → API gateway
# Leave blank for local dev (middleware falls back to path-based routing)
FBEDS_ROOT_DOMAIN=

# Portal URLs used for cross-app redirects and nav links
NEXT_PUBLIC_AGENT_URL=http://localhost:3001
NEXT_PUBLIC_ADMIN_URL=http://localhost:3002
NEXT_PUBLIC_SUPPLIER_URL=http://localhost:3003
