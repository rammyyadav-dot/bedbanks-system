# Supplier Extranet: local development only. Use verified HTTPS values on Vercel.
# Server-only API base, including /api/v1; required for Vercel builds and production runtime.
API_INTERNAL_URL=http://localhost:3002/api/v1
# Exact Supplier browser origin. Must be approved in the API TRUSTED_ORIGINS.
# Required by server-side authentication and Supplier API requests.
SUPPLIER_ORIGIN=http://localhost:3003
# Must match the API cookie name. Use HTTPS for Secure session cookies.
AUTH_COOKIE_NAME=fbeds_session
# Optional https URL of the public fabBeds site. Shows a "Home" link on the sign-in card when set.
FABBEDS_HOME_URL=
# Browser calls use the same-origin /api/v1 proxy; no public API URL is needed.
