# FBEDS API — environment variables
# Copy this file to apps/api/.env and adjust as needed for local development.
# Never commit a real .env file — see .gitignore.

NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3002
API_PREFIX=api/v1

# P0-C / P0-01 (ADR 0040): TWO database credentials, never interchangeable.
#
#   DATABASE_URL           the RESTRICTED runtime login (fbeds_api_login): what the API process uses. The API refuses to start if this is a superuser,
#                          BYPASSRLS, an owner of tables, or a known owner/admin login (postgres, neondb_owner, ...).
#   MIGRATION_DATABASE_URL the OWNER login: schema migrations and role provisioning only (pnpm prisma:migrate:deploy:owner, ops:provision-*).
#                          Never set it on a running service; use it in a release job or your shell for one command.
#
# Local setup: create the database with your owner, set MIGRATION_DATABASE_URL in your shell, run `pnpm prisma:migrate:deploy:owner`, then
# `PROVISION_DATABASE_URL=$MIGRATION_DATABASE_URL API_RUNTIME_LOGIN_PASSWORD=<generated> pnpm ops:provision-api-runtime-role` and put that login below.
# Schema: apps/api/prisma/schema.prisma.
DATABASE_URL=postgresql://fbeds_api_login:CHANGE_ME_generated_password@localhost:5432/fbeds_dev
# MIGRATION_DATABASE_URL=<owner connection string; shell/release job only, never committed or set on the service>

# P0-D: authentication (opaque database-backed sessions, not JWT).
AUTH_SESSION_TTL_SECONDS=28800
AUTH_COOKIE_NAME=fbeds_session
# Required in all environments. Use HTTPS; localhost browser exceptions vary.
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAME_SITE=lax

# P0-D: credentialed CORS. Must be an explicit origin, never a wildcard,
# because it's paired with credentials: true.
ADMIN_ORIGIN=http://localhost:3001
# Other portals that proxy cookie-authenticated requests to this API (ADR 0010):
# comma-separated exact origins. Local Agent portal:
TRUSTED_ORIGINS=http://localhost:3000

# P0-D: seed script credentials for local development only. Set your
# own values here — never commit real credentials, never reuse this
# password anywhere real.
FBEDS_SEED_ADMIN_EMAIL=owner@demo-agency.example
FBEDS_SEED_ADMIN_PASSWORD=change-me-locally-before-seeding

# Inventory hold expiry sweeper (ADR 0005). Disabled by default. Enable only
# with a dedicated restricted background-role credential that is DIFFERENT from
# DATABASE_URL; the API refuses to start if it is missing or reused.
HOLD_EXPIRY_SWEEP_ENABLED=false
# HOLD_EXPIRY_DATABASE_URL=<secret reference; never commit a real value>
# HOLD_EXPIRY_SWEEP_INTERVAL_MS=60000
