# FBEDS API — P0-B environment variables
# Copy this file to apps/api/.env and adjust as needed for local development.
# Never commit a real .env file — see .gitignore.

NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3001
API_PREFIX=api/v1

# P0-C: local Postgres connection. Replace credentials for your machine.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fbeds_dev

# Redis and authentication variables are intentionally NOT listed here
# yet — those belong to later phases.
