# FBEDS API — P0-B environment variables
# Copy this file to apps/api/.env and adjust as needed for local development.
# Never commit a real .env file — see .gitignore.

NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3001
API_PREFIX=api/v1

# Database, Redis, and authentication variables are intentionally NOT
# listed here yet — those belong to P0-C and later phases.
