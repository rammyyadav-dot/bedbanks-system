// FBEDS — Prisma schema
//
// Scope discipline: identity + authentication foundation.
//   - Tenant, User, Membership — who exists and who belongs where (P0-C)
//   - Status (Tenant/User) — minimal lifecycle only: ACTIVE/SUSPENDED.
//     Not a general workflow state machine — don't overbuild this.
//   - User.passwordHash, User.lastLoginAt, Session — P0-D authentication.
//     Opaque, database-backed sessions, NOT JWT: the browser holds a
//     random token in an HttpOnly cookie; the database holds only a
//     SHA-256 hash of it (Session.tokenHash). This is a deliberate
//     architecture choice over JWT — see apps/api/src/auth/README.md
//     for the reasoning (immediate revocation, no refresh-token
//     complexity yet, simpler to reason about for this stage).
//   - Membership.role is a plain string for now (e.g. "owner", "member").
//     Formal roles/permissions tables are P0-F (RBAC) — don't confuse
//     the two.
//
// PostgreSQL row-level security is added by the forward-only
// 202609180001_prisma_tenant_finance_hardening migration. Prisma schema
// remains the authority for tables and relations; PostgreSQL owns the RLS
// policies, triggers and audit access controls that Prisma cannot model.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Minimal lifecycle status shared by Tenant and User. Deliberately
/// just two states — a full workflow (PENDING, INVITED, ARCHIVED, ...)
/// is a later, explicit decision, not something to grow accidentally.
enum Status {
  ACTIVE
  SUSPENDED
}

/// Booking lifecycle (ADR 0039, docs/booking-module-spec.md). `Closed` is not a status: it is a lock (`closedAt`, added later).
/// Only the booking transition function may write this (Phase 2). The hold/prebook intake machine is `BookingTransactionState`.
enum BookingStatus {
  PENDING_SUPPLIER
  ON_REQUEST
  CONFIRMED
  AMEND_REQUESTED
  CANCEL_REQUESTED
  CANCELLED
  CHECKED_OUT
  NO_SHOW
  REJECTED
  FAILED
}

/// How a booking arrived (spec workflow A). Existing bookings all came through the Agent portal.
enum BookingChannel {
  PORTAL
  API
  MANUAL
}

enum BookingPaymentMode {
  CREDIT
  PREPAID
  PAY_AT_HOTEL
}

enum BookingPaymentStatus {
  PAID
  UNPAID
  OVERDUE
}

enum BookingGuestType {
  ADULT
  CHILD
}

enum BookingFinanceEventType {
  CONFIRMED
  ON_REQUEST_HOLD
  HOLD_RELEASED
  CANCELLED
  PENALTY_DECIDED
  PENALTY_WAIVED
}

enum BookingOpsPriority {
  NORMAL
  HIGH
  URGENT
  CRITICAL
}

enum BookingSupplierJobKind {
  BOOK
  CANCEL
  STATUS_CHECK
}

enum BookingSupplierJobStatus {
  QUEUED
  RUNNING
  RETRY_WAIT
  SUCCEEDED
  FAILED
  UNKNOWN
}

enum BookingActorType {
  USER
  SYSTEM
  SUPPLIER
}

enum BookingDocumentType {
  VOUCHER
  INVOICE
  CREDIT_NOTE
  CANCELLATION_NOTE
}

/// Clients, Service and Distribution (ADR 0019). Record-keeping and exposure control only: nothing here moves money,
/// sets a credit limit, or changes a booking. A restriction hides inventory from one agency's members in Agent search.
enum AgencyStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

/// Credit limit for one agency in one currency (ADR 0024). No row means no limit is configured (not enforced).
/// Integer minor units only. Changed only through an approved maker-checker request.
model AgencyCreditLimit {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agencyId    String   @unique @map("agency_id")
  agency      Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  currency    String   @db.Char(3)
  limitMinor  BigInt   @map("limit_minor")
  updatedById String   @map("updated_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([tenantId, agencyId])
}

/// Hotel image (ADR 0027). Bytes are stored in PostgreSQL behind a storage port; list queries must omit `data`.
model HotelImage {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  hotelId      String   @map("hotel_id")
  hotel        Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  contentType  String   @map("content_type")
  bytes        Int
  width        Int
  height       Int
  sha256       String   @db.Char(64)
  altText      String   @map("alt_text")
  sortOrder    Int      @default(0) @map("sort_order")
  isPrimary    Boolean  @default(false) @map("is_primary")
  data         Bytes
  uploadedById String   @map("uploaded_by_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([hotelId, sha256])
  @@index([tenantId, hotelId, sortOrder])
}

model Agency {
  bookings Booking[]
  id          String       @id @default(cuid())
  tenantId    String       @map("tenant_id")
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  /// Short stable code, unique per tenant (for example `GULF-TRAVEL`).
  code        String
  name        String
  countryCode String?      @map("country_code") @db.Char(2)
  status      AgencyStatus @default(ACTIVE)
  /// Business notes only. Never guest PII, card data or credentials.
  notes       String?
  createdById String       @map("created_by_id")
  createdBy   User         @relation("AgencyCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  members      AgencyMember[]
  cases        ServiceCase[]
  restrictions DistributionRestriction[]
  creditLimit  AgencyCreditLimit?
  accounts     Wallet[]
  fundingReceipts FundingReceipt[]

  @@unique([tenantId, code])
  @@unique([tenantId, id])
  @@index([tenantId, status])
}

/// A user belongs to at most one agency per tenant.
model AgencyMember {
  agencyId  String   @map("agency_id")
  agency    Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  tenantId  String   @map("tenant_id")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@id([agencyId, userId])
  @@unique([tenantId, userId])
  @@index([tenantId, agencyId])
}

enum ServiceCaseCategory {
  BOOKING
  HOTEL
  SUPPLIER
  AGENCY
  OTHER
}

enum ServiceCasePriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum ServiceCaseStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

/// A support case. It observes other records through optional links and never changes them.
model ServiceCase {
  id          String              @id @default(cuid())
  tenantId    String              @map("tenant_id")
  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  /// Human reference, unique per tenant (`SC-` plus eight characters).
  reference   String
  subject     String
  /// Describe the problem with identifiers. Do not enter guest names, contact details or card data.
  description String
  category    ServiceCaseCategory
  priority    ServiceCasePriority @default(NORMAL)
  status      ServiceCaseStatus   @default(OPEN)
  bookingId   String?             @map("booking_id")
  booking     Booking?            @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  hotelId     String?             @map("hotel_id")
  hotel       Hotel?              @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  supplierId  String?             @map("supplier_id")
  supplier    Supplier?           @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  agencyId    String?             @map("agency_id")
  agency      Agency?             @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  openedById  String              @map("opened_by_id")
  openedBy    User                @relation("CaseOpener", fields: [openedById], references: [id], onDelete: Restrict)
  assigneeId  String?             @map("assignee_id")
  assignee    User?               @relation("CaseAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  resolvedAt  DateTime?           @map("resolved_at")
  closedAt    DateTime?           @map("closed_at")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  notes ServiceCaseNote[]

  @@unique([tenantId, reference])
  @@index([tenantId, status])
  @@index([tenantId, assigneeId, status])
  @@index([tenantId, bookingId])
}

/// Append-only: the API role is granted INSERT and SELECT only.
model ServiceCaseNote {
  id        String      @id @default(cuid())
  tenantId  String      @map("tenant_id")
  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  caseId    String      @map("case_id")
  case      ServiceCase @relation(fields: [caseId], references: [id], onDelete: Restrict)
  authorId  String      @map("author_id")
  author    User        @relation(fields: [authorId], references: [id], onDelete: Restrict)
  body      String
  createdAt DateTime    @default(now()) @map("created_at")

  @@index([tenantId, caseId, createdAt])
}

enum DistributionScope {
  HOTEL
  SUPPLIER
}

enum DistributionRestrictionStatus {
  ACTIVE
  RETIRED
}

/// Hides one hotel, or all of one supplier's inventory, from the members of one agency in Agent search, recheck and hold.
/// At most one ACTIVE restriction per (agency, scope, target): a partial unique index in the migration.
model DistributionRestriction {
  id          String                        @id @default(cuid())
  tenantId    String                        @map("tenant_id")
  tenant      Tenant                        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  agencyId    String                        @map("agency_id")
  agency      Agency                        @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  scope       DistributionScope
  hotelId     String?                       @map("hotel_id")
  hotel       Hotel?                        @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  supplierId  String?                       @map("supplier_id")
  supplier    Supplier?                     @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  status      DistributionRestrictionStatus @default(ACTIVE)
  reason      String
  createdById String                        @map("created_by_id")
  createdBy   User                          @relation("RestrictionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  retiredAt   DateTime?                     @map("retired_at")
  createdAt   DateTime                      @default(now()) @map("created_at")
  updatedAt   DateTime                      @updatedAt @map("updated_at")

  @@index([tenantId, status])
  @@index([tenantId, agencyId, status])
}

/// Percent markup applied to NET daily rates (ADR 0018). Rules are immutable once created: only the status moves
/// (DRAFT to ACTIVE through an approved request, ACTIVE or DRAFT to RETIRED). At most one ACTIVE rule exists per
/// (tenant, scope, supplier, hotel): a partial unique index in the migration, which Prisma cannot model.
enum MarkupScope {
  TENANT_DEFAULT
  SUPPLIER
  HOTEL
}

enum MarkupRuleStatus {
  DRAFT
  ACTIVE
  RETIRED
}

model CommercialMarkupRule {
  id          String           @id @default(cuid())
  tenantId    String           @map("tenant_id")
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  scope       MarkupScope
  supplierId  String?          @map("supplier_id")
  supplier    Supplier?        @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  hotelId     String?          @map("hotel_id")
  hotel       Hotel?           @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  /// 0 to 10000 (zero to one hundred percent). Integer basis points only.
  basisPoints Int              @map("basis_points")
  /// First and last night the rule applies to (inclusive). validTo null means open-ended.
  validFrom   DateTime         @map("valid_from") @db.Date
  validTo     DateTime?        @map("valid_to") @db.Date
  status      MarkupRuleStatus @default(DRAFT)
  reason      String
  createdById String           @map("created_by_id")
  createdBy   User             @relation("MarkupRuleCreator", fields: [createdById], references: [id], onDelete: Restrict)
  activatedAt DateTime?        @map("activated_at")
  retiredAt   DateTime?        @map("retired_at")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  @@index([tenantId, status])
  @@index([tenantId, scope, supplierId, hotelId])
}

/// Maker-checker foundation (ADR 0016). A request records who asked for a sensitive action and who decided it.
/// Approval never executes the action and never replaces domain validation; the owning canonical service does that.
enum ApprovalRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  /// An APPROVED request that its owning service has claimed and run. Single use.
  EXECUTED
}

model ApprovalRequest {
  id             String                @id @default(cuid())
  tenantId       String                @map("tenant_id")
  tenant         Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  /// A permission key from the catalogue, for example `refund.approve`.
  action         String
  entityType     String                @map("entity_type")
  entityId       String                @map("entity_id")
  requestId      String                @map("request_id")
  status         ApprovalRequestStatus @default(PENDING)
  requestedById  String                @map("requested_by_id")
  requestedBy    User                  @relation("ApprovalRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  reason         String
  /// Minimal before/after state. Never guest PII, credentials or raw supplier payloads.
  beforeState    Json?                 @map("before_state")
  proposedState  Json?                 @map("proposed_state")
  decidedById    String?               @map("decided_by_id")
  decidedBy      User?                 @relation("ApprovalDecider", fields: [decidedById], references: [id], onDelete: Restrict)
  decidedAt      DateTime?             @map("decided_at")
  decisionReason String?               @map("decision_reason")
  executedById   String?               @map("executed_by_id")
  executedBy     User?                 @relation("ApprovalExecutor", fields: [executedById], references: [id], onDelete: Restrict)
  executedAt     DateTime?             @map("executed_at")
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")

  @@unique([tenantId, action, requestId])
  @@index([tenantId, status])
  @@index([tenantId, entityType, entityId])
}

/// Outbound supplier side-effect boundary. Independent of Booking and AuditEvent.
enum SupplierMutationOperation {
  PREBOOK
  BOOK
  CANCEL
}

/// PREPARED: not sent. SENDING/UNKNOWN: may have been sent. ACKNOWLEDGED/REJECTED/RESOLVED: observed.
enum SupplierMutationStatus {
  PREPARED
  SENDING
  ACKNOWLEDGED
  REJECTED
  UNKNOWN
  RESOLVED
}

/// How a night's stock is sold (ADR 0030). One explicit semantic per plan-night, never a magic quantity.
enum InventoryMode {
  ALLOTMENT
  FREE_SALE
  ON_REQUEST
  CLOSED
}

/// Where inventory data came from. Supplier sources must carry `freshUntil` or they are treated as stale.
enum InventorySource {
  CONTRACT
  ADMIN
  SUPPLIER_API
  SUPPLIER_FEED
  SYSTEM
}

enum InventoryPoolStatus {
  ACTIVE
  ARCHIVED
}

/// Which counter a held or sold night was taken from, recorded at reservation time so later release, confirmation and cancellation
/// always return to the same counter even if pool membership changes.
enum InventoryCounterKind {
  PLAN_ROW
  POOL_DAY
  NONE
}

enum InventoryHoldStatus {
  PENDING_RECHECK
  RECHECKED
  HOLD_PENDING
  HELD
  PROCESSING
  CONFIRMED
  RELEASED
  EXPIRED
  FAILED
}

enum AuditActorType {
  USER
  SYSTEM
}

enum LedgerEntryType {
  CREDIT
  DEBIT
  HOLD
  RELEASE
  REFUND
}

enum SupplierType {
  HOTEL_DIRECT
  DMC
  CHANNEL_MANAGER
  BEDBANK
  GDS
}

enum SupplierStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum ContentStatus {
  DRAFT
  INCOMPLETE
  COMPLETE
  SUSPENDED
}

enum ContractStatus {
  DRAFT
  REVIEW
  ACTIVE
  EXPIRED
  SUSPENDED
}

enum MappingStatus {
  PENDING
  MAPPED
  REJECTED
}

/// Extranet access for one supplier organization. This is not an admin role.
enum SupplierMembershipStatus {
  ACTIVE
  SUSPENDED
  REVOKED
}

enum RatePlanStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  EXPIRED
}

/// Declares the commercial meaning of DailyRate.amountMinor. Legacy rows are
/// intentionally nullable and therefore not sellable until explicitly classified.
enum RateAmountBasis {
  NET
  SELL
}

enum ConnectorType {
  API_JSON
  XML_IN
  XML_OUT
  CHANNEL_MANAGER
  MANUAL_EXTRANET
}

enum ConnectorStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  DISABLED
}

enum ConnectorExecutionStatus {
  RECEIVED
  PROCESSING
  SUCCEEDED
  FAILED
  RETRYING
}

model Tenant {
  bookingRooms BookingRoom[]
  bookingGuests BookingGuest[]
  bookingEvents BookingEvent[]
  bookingSupplierJobs BookingSupplierJob[]
  bookingSupplierCalls BookingSupplierCall[]
  bookingOpsStates BookingOpsState[]
  bookingFinanceEvents BookingFinanceEvent[]
  bookingSavedViews BookingSavedView[]
  bookingBulkOperations BookingBulkOperation[]
  bookingBulkOperationItems BookingBulkOperationItem[]
  agencies Agency[]
  inventoryPools InventoryPool[]
  hotelImages HotelImage[]
  agencyCreditLimits AgencyCreditLimit[]
  fundingReceipts FundingReceipt[]
  hotelProfiles HotelProfile[]
  hotelExternalIdentifiers HotelExternalIdentifier[]
  hotelAmenities HotelAmenity[]
  roomAmenities RoomAmenity[]
  agencyMembers AgencyMember[]
  serviceCases ServiceCase[]
  serviceCaseNotes ServiceCaseNote[]
  distributionRestrictions DistributionRestriction[]
  markupRules CommercialMarkupRule[]
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  status    Status   @default(ACTIVE)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships Membership[]
  roles       Role[]
  roleAssignments UserRole[]
  bookings    Booking[]
  bookingDocuments BookingDocument[]
  wallets     Wallet[]
  ledger      LedgerEntry[]
  auditEvents AuditEvent[]
  suppliers   Supplier[]
  hotels      Hotel[]
  hotelSearchIndexes HotelSearchIndex[]
  boardBases  BoardBasis[]
  contracts   Contract[]
  connectorDefinitions ConnectorDefinition[]
  inventoryUpdateEvents InventoryUpdateEvent[]
  inventoryHolds InventoryHold[]
  supplierMutations SupplierMutation[]
  approvalRequests ApprovalRequest[]
  settings    TenantSettings?
  supplierMemberships SupplierMembership[]
  supplierRoomDrafts SupplierRoomDraft[]

  @@map("tenants")
}

/// Workspace preferences for the authenticated tenant. Default currency is
/// display and alert configuration only — it does not rewrite wallets or ledger.
model TenantSettings {
  id                       String   @id @default(cuid())
  tenantId                 String   @unique @map("tenant_id")
  tenant                   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supportEmail             String?  @map("support_email")
  defaultLanguage          String   @default("en") @map("default_language")
  timeZone                 String   @default("UTC") @map("time_zone")
  defaultCurrency          String   @default("USD") @db.Char(3) @map("default_currency")
  lowBalanceThresholdMinor BigInt   @default(0) @map("low_balance_threshold_minor")
  lowBalanceCurrency       String   @default("USD") @db.Char(3) @map("low_balance_currency")
  lastIdempotencyKey       String?  @map("last_idempotency_key")
  lastMutationFingerprint  String?  @map("last_mutation_fingerprint")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  @@map("tenant_settings")
}

model User {
  bookingSupplierJobs BookingSupplierJob[] @relation("BookingSupplierJobRequester")
  bookingFinanceActed BookingFinanceEvent[] @relation("BookingFinanceActor")
  bookingOpsAssigned BookingOpsState[] @relation("BookingOpsAssignee")
  bookingOpsAssignedBy BookingOpsState[] @relation("BookingOpsAssignedBy")
  bookingOpsAcknowledged BookingOpsState[] @relation("BookingOpsAcknowledgedBy")
  bookingOpsEscalated BookingOpsState[] @relation("BookingOpsEscalatedBy")
  bookingOpsResolved BookingOpsState[] @relation("BookingOpsResolvedBy")
  bookingsAsAgent Booking[] @relation("BookingAgent")
  bookingsAssigned Booking[] @relation("BookingAssignee")
  agencyMemberships AgencyMember[]
  agenciesCreated Agency[] @relation("AgencyCreator")
  casesOpened ServiceCase[] @relation("CaseOpener")
  casesAssigned ServiceCase[] @relation("CaseAssignee")
  caseNotes ServiceCaseNote[]
  restrictionsCreated DistributionRestriction[] @relation("RestrictionCreator")
  markupRulesCreated CommercialMarkupRule[] @relation("MarkupRuleCreator")
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  passwordHash String?   @map("password_hash")
  status       Status    @default(ACTIVE)
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  memberships Membership[]
  sessions    Session[]
  roles       UserRole[]
  supplierMemberships SupplierMembership[]
  platformRoleAssignments PlatformRoleAssignment[]
  auditEvents AuditEvent[]
  approvalsRequested ApprovalRequest[] @relation("ApprovalRequester")
  approvalsDecided ApprovalRequest[] @relation("ApprovalDecider")
  approvalsExecuted ApprovalRequest[] @relation("ApprovalExecutor")

  @@map("users")
}

/// Links a User to a Tenant. `role` is a plain string placeholder for
/// P0-C — real role/permission modeling is P0-F, not here.
model Membership {
  id        String   @id @default(cuid())
  role      String   @default("member")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  savedViews BookingSavedView[]
  bulkOperations BookingBulkOperation[]

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@map("memberships")
}

/// Opaque, database-backed session (P0-D). The raw session token is
/// NEVER stored here — only SHA-256(token), in tokenHash. If this
/// table is ever compromised, the hashes alone can't be replayed as
/// valid session cookies. Deleting a User cascades to their sessions.
model Session {
  id         String    @id @default(cuid())
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  lastSeenAt DateTime  @default(now()) @map("last_seen_at")
  revokedAt  DateTime? @map("revoked_at")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  description String?
  roles       RolePermission[]
}

model Role {
  id          String           @id @default(cuid())
  name        String
  tenantId    String           @map("tenant_id")
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users       UserRole[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now()) @map("created_at")

  @@unique([tenantId, name])
  @@index([tenantId])
}

model UserRole {
  userId String @map("user_id")
  roleId String @map("role_id")
  tenantId String @map("tenant_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([tenantId])
}

model RolePermission {
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model PlatformPermission {
  id          String @id
  key         String @unique
  description String?
  roles       PlatformRolePermission[]
}

model PlatformRole {
  id           String @id
  name         String @unique
  description  String?
  createdAt    DateTime @default(now()) @map("created_at")
  permissions  PlatformRolePermission[]
  assignments  PlatformRoleAssignment[]
}

model PlatformRolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")
  role         PlatformRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   PlatformPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model PlatformRoleAssignment {
  userId    String @map("user_id")
  roleId    String @map("role_id")
  createdAt DateTime @default(now()) @map("created_at")
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      PlatformRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model Booking {
  serviceCases ServiceCase[]
  id             String         @id @default(cuid())
  tenantId       String         @map("tenant_id")
  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  reference      String         @unique
  supplier       String
  hotelId        String         @map("hotel_id")
  status         BookingStatus  @default(PENDING_SUPPLIER)
  currency       String
  totalMinor     BigInt         @map("total_minor")
  idempotencyKey String         @map("idempotency_key")
  searchSnapshot Json           @map("search_snapshot")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  cancellations  Cancellation[]
  documents      BookingDocument[]
  supplierMutations SupplierMutation[]

  // ---- Admin booking module (ADR 0039). Every new column is nullable or defaulted, so existing rows stay valid. A null is "unknown", never zero or false.
  /// The agency (the bedbank's customer) that made the booking. Null: not derivable for older bookings, shown as "Unassigned" and visible only to operator-level readers.
  agencyId            String?               @map("agency_id")
  agency              Agency?               @relation(fields: [tenantId, agencyId], references: [tenantId, id], onDelete: Restrict)
  /// The agent who made it. A user can be removed, so this is SET NULL; the agency link above is the durable one.
  agentUserId         String?               @map("agent_user_id")
  agentUser           User?                 @relation("BookingAgent", fields: [agentUserId], references: [id], onDelete: SetNull)
  channel             BookingChannel        @default(PORTAL)
  agentRef            String?               @map("agent_ref")
  /// The supplier's own answer, kept apart from `status` (a free supplier word such as CONFIRMED or ON_REQUEST).
  supplierStatus      String?               @map("supplier_status")
  supplierRef         String?               @map("supplier_ref")
  hotelConfirmationNo String?               @map("hotel_confirmation_no")
  /// Promoted from the frozen search snapshot so the list can filter and sort on them.
  checkIn             DateTime?             @map("check_in") @db.Date
  checkOut            DateTime?             @map("check_out") @db.Date
  nights              Int?
  /// Integer minor units in `currency` (the sell amount is `totalMinor`). Unknown stays null.
  netMinor            BigInt?               @map("net_minor")
  markupMinor         BigInt?               @map("markup_minor")
  /// Foreign-exchange rate frozen at booking time. Reports convert with this, never today's rate.
  fxRate              Decimal?              @map("fx_rate") @db.Decimal(18, 8)
  paymentMode         BookingPaymentMode?   @map("payment_mode")
  paymentStatus       BookingPaymentStatus? @map("payment_status")
  isRefundable        Boolean?              @map("is_refundable")
  /// Free-cancellation deadline in UTC; shown in hotel local time.
  cancelDeadline      DateTime?             @map("cancel_deadline")
  assignedToId        String?               @map("assigned_to_id")
  assignedTo          User?                 @relation("BookingAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  /// Optimistic version: bumped by the transition function (Phase 2).
  version             Int                   @default(1)
  /// "Closed" is a lock, not a status (spec decision 2): the last real status stays visible.
  closedAt            DateTime?             @map("closed_at")
  rooms               BookingRoom[]
  guests              BookingGuest[]
  events              BookingEvent[]
  supplierJobs        BookingSupplierJob[]
  opsState            BookingOpsState?
  financeEvents       BookingFinanceEvent[]
  /// The cancellation rules frozen with the booking (Phase 5): { rules: [{ daysBeforeCheckin, penaltyPercent | penaltyMinor }], frozenAt, source }. Written at creation only.
  cancellationPolicy  Json?                 @map("cancellation_policy")
  supplierCalls       BookingSupplierCall[]

  @@unique([tenantId, id])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status])
  @@index([tenantId, status, checkIn])
  @@index([tenantId, agencyId, status])
  @@index([tenantId, supplierRef])
  @@index([tenantId, hotelConfirmationNo])
  @@index([tenantId, agentRef])
  @@index([tenantId, cancelDeadline])
  @@index([tenantId, createdAt])
}

/// The booked room product(s). `quantity` rooms of this type and board; occupancy is per room.
model BookingRoom {
  id         String         @id @default(cuid())
  tenantId   String         @map("tenant_id")
  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  bookingId  String         @map("booking_id")
  booking    Booking        @relation(fields: [tenantId, bookingId], references: [tenantId, id], onDelete: Cascade)
  position   Int            @default(1)
  quantity   Int            @default(1)
  roomTypeId String?        @map("room_type_id")
  roomName   String?        @map("room_name")
  boardCode  String?        @map("board_code")
  adults     Int
  children   Int            @default(0)
  childAges  Int[]          @map("child_ages")
  rateKey    String?        @map("rate_key")
  sellMinor  BigInt?        @map("sell_minor")
  netMinor   BigInt?        @map("net_minor")
  createdAt  DateTime       @default(now()) @map("created_at")
  guests     BookingGuest[]

  @@unique([tenantId, id])
  @@index([tenantId, bookingId])
}

/// Guest personal data: masked for readers without `booking.pii.view`; every unmasked read is audited. Never logged.
model BookingGuest {
  id        String           @id @default(cuid())
  tenantId  String           @map("tenant_id")
  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  bookingId String           @map("booking_id")
  booking   Booking          @relation(fields: [tenantId, bookingId], references: [tenantId, id], onDelete: Cascade)
  roomId    String?          @map("room_id")
  room      BookingRoom?     @relation(fields: [tenantId, roomId], references: [tenantId, id], onDelete: NoAction)
  title     String?
  firstName String           @map("first_name")
  lastName  String           @map("last_name")
  isLead    Boolean          @default(false) @map("is_lead")
  type      BookingGuestType @default(ADULT)
  age       Int?
  createdAt DateTime         @default(now()) @map("created_at")

  @@index([tenantId, bookingId])
  @@index([tenantId, lastName])
}

/// Immutable lifecycle log. One row per status change, written by the transition function in the same transaction (Phase 2).
/// A database trigger rejects UPDATE and DELETE. Rows written by the migration backfill say so in `payload`.
enum BookingBulkActionType {
  ASSIGN_OWNER
  ACKNOWLEDGE
}

enum BookingBulkStatus {
  PENDING
  PROCESSING
  PARTIAL
  SUCCEEDED
  FAILED
}

enum BookingBulkSelectionMode {
  EXPLICIT_IDS
}

enum BookingBulkItemStatus {
  PENDING
  SUCCEEDED
  FAILED
}

/// One bulk request (ADR 0039, Phase 6C): orchestration record only. The effect of each item is made by the existing single-booking service. Idempotent by the
/// unique key (tenant, requester, action, idempotency key). Stores ids, counts and stable codes, never guest data or exception text.
model BookingBulkOperation {
  id                 String                   @id @default(cuid())
  tenantId           String                   @map("tenant_id")
  tenant             Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requestedByUserId  String                   @map("requested_by_user_id")
  membership         Membership               @relation(fields: [requestedByUserId, tenantId], references: [userId, tenantId], onDelete: Cascade)
  actionType         BookingBulkActionType    @map("action_type")
  status             BookingBulkStatus        @default(PENDING)
  selectionMode      BookingBulkSelectionMode @default(EXPLICIT_IDS) @map("selection_mode")
  requestVersion     Int                      @default(1) @map("request_version")
  actionPayload      Json                     @default("{}") @map("action_payload")
  idempotencyKey     String                   @map("idempotency_key") @db.VarChar(128)
  requestFingerprint String                   @map("request_fingerprint") @db.Char(64)
  requestedCount     Int                      @map("requested_count")
  processedCount     Int                      @default(0) @map("processed_count")
  succeededCount     Int                      @default(0) @map("succeeded_count")
  failedCount        Int                      @default(0) @map("failed_count")
  startedAt          DateTime?                @map("started_at")
  completedAt        DateTime?                @map("completed_at")
  createdAt          DateTime                 @default(now()) @map("created_at")
  updatedAt          DateTime                 @updatedAt @map("updated_at")
  items              BookingBulkOperationItem[]

  @@unique([tenantId, id])
  @@unique([tenantId, requestedByUserId, actionType, idempotencyKey], map: "BookingBulkOperation_idempotency_key")
  @@index([tenantId, requestedByUserId, createdAt], map: "BookingBulkOperation_requester_created_idx")
}

/// One selected booking in a bulk request. `bookingId` is deliberately not a foreign key: an id that does not exist must still be recorded as NOT_FOUND.
model BookingBulkOperationItem {
  id          String                @id @default(cuid())
  tenantId    String                @map("tenant_id")
  tenant      Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  operationId String                @map("operation_id")
  operation   BookingBulkOperation  @relation(fields: [tenantId, operationId], references: [tenantId, id], onDelete: Cascade)
  bookingId   String                @map("booking_id") @db.VarChar(80)
  position    Int
  status      BookingBulkItemStatus @default(PENDING)
  errorCode   String?               @map("error_code") @db.VarChar(40)
  processedAt DateTime?             @map("processed_at")

  @@unique([operationId, bookingId])
  @@index([tenantId, operationId])
}

/// A person's saved view of the booking list (ADR 0039, Phase 6B): a preference, never a security policy. Re-validated on every open.
/// `defaultSlot` is 1 on the person's default view and NULL otherwise; the unique key over it allows at most one default per person per tenant.
model BookingSavedView {
  id                 String     @id @default(cuid())
  tenantId           String     @map("tenant_id")
  tenant             Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ownerUserId        String     @map("owner_user_id")
  membership         Membership @relation(fields: [ownerUserId, tenantId], references: [userId, tenantId], onDelete: Cascade)
  name               String     @db.VarChar(60)
  nameKey            String     @map("name_key") @db.VarChar(60)
  description        String?    @db.VarChar(200)
  filterVersion      Int        @default(1) @map("filter_version")
  filtersJson        Json       @map("filters_json")
  sortJson           Json       @map("sort_json")
  visibleColumnsJson Json?      @map("visible_columns_json")
  defaultSlot        Int?       @map("default_slot") @db.SmallInt
  version            Int        @default(1)
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")

  @@unique([tenantId, ownerUserId, nameKey])
  @@unique([tenantId, ownerUserId, defaultSlot])
  @@index([tenantId, ownerUserId])
}

/// Money facts of the Admin booking module (ADR 0039, Phase 5): an append-only outbox the Finance module reads. Nothing here posts to a ledger or touches a balance.
model BookingFinanceEvent {
  id            String                   @id @default(cuid())
  tenantId      String                   @map("tenant_id")
  tenant        Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  bookingId     String                   @map("booking_id")
  booking       Booking                  @relation(fields: [tenantId, bookingId], references: [tenantId, id], onDelete: Cascade)
  type          BookingFinanceEventType
  seq           Int                      @default(1)
  currency      String                   @db.Char(3)
  sellMinor     BigInt                   @map("sell_minor")
  netMinor      BigInt?                  @map("net_minor")
  penaltyMinor  BigInt?                  @map("penalty_minor")
  refundMinor   BigInt?                  @map("refund_minor")
  paymentMode   BookingPaymentMode?      @map("payment_mode")
  actorUserId   String?                  @map("actor_user_id")
  actor         User?                    @relation("BookingFinanceActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  payload       Json                     @default("{}")
  createdAt     DateTime                 @default(now()) @map("created_at")

  @@unique([tenantId, bookingId, type, seq])
  @@index([tenantId, bookingId, createdAt])
  @@index([tenantId, type, createdAt])
}

/// Durable operational state of the booking operations queue (ADR 0039, Phase 4): owner, acknowledgement, a manual priority floor, a manual follow-up flag.
/// The queue itself, SLA state, reason and priority are derived and never stored here.
model BookingOpsState {
  id                   String              @id @default(cuid())
  tenantId             String              @map("tenant_id")
  tenant               Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  bookingId            String              @map("booking_id")
  booking              Booking             @relation(fields: [tenantId, bookingId], references: [tenantId, id], onDelete: Cascade)
  assigneeUserId       String?             @map("assignee_user_id")
  assignee             User?               @relation("BookingOpsAssignee", fields: [assigneeUserId], references: [id], onDelete: SetNull)
  assignedAt           DateTime?           @map("assigned_at")
  assignedByUserId     String?             @map("assigned_by_user_id")
  assignedBy           User?               @relation("BookingOpsAssignedBy", fields: [assignedByUserId], references: [id], onDelete: SetNull)
  acknowledgedAt       DateTime?           @map("acknowledged_at")
  acknowledgedByUserId String?             @map("acknowledged_by_user_id")
  acknowledgedBy       User?               @relation("BookingOpsAcknowledgedBy", fields: [acknowledgedByUserId], references: [id], onDelete: SetNull)
  manualPriority       BookingOpsPriority? @map("manual_priority")
  escalatedAt          DateTime?           @map("escalated_at")
  escalatedByUserId    String?             @map("escalated_by_user_id")
  escalatedBy          User?               @relation("BookingOpsEscalatedBy", fields: [escalatedByUserId], references: [id], onDelete: SetNull)
  escalationReason     String?             @map("escalation_reason")
  followUp             Boolean             @default(false) @map("follow_up")
  followUpAt           DateTime?           @map("follow_up_at")
  resolvedAt           DateTime?           @map("resolved_at")
  resolvedByUserId     String?             @map("resolved_by_user_id")
  resolvedBy           User?               @relation("BookingOpsResolvedBy", fields: [resolvedByUserId], references: [id], onDelete: SetNull)
  version              Int                 @default(1)
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  @@unique([tenantId, bookingId])
  @@index([tenantId, assigneeUserId])
  @@index([tenantId, updatedAt])
}

/// Supplier work queue for the Admin booking module (ADR 0039, Phase 3): book, cancel, status check. One first try plus three retries (30 s / 2 min / 5 min).
model BookingSupplierJob {
  id                String                   @id @default(cuid())
  tenantId          String                   @map("tenant_id")
  tenant            Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  bookingId         String                   @map("booking_id")
  booking           Booking                  @relation(fields: [tenantId, bookingId], references: [tenantId, id], onDelete: Cascade)
  kind              BookingSupplierJobKind
  status            BookingSupplierJobStatus @default(QUEUED)
  attempt           Int                      @default(0)
  maxAttempts       Int                      @default(4) @map("max_attempts")
  runAfter          DateTime                 @map("run_after")
  lockedUntil       DateTime?                @map("locked_until")
  requestedByUserId String?                  @map("requested_by_user_id")
  requestedBy       User?                    @relation("BookingSupplierJobRequester", fields: [requestedByUserId], references: [id], onDelete: SetNull)
  idempotencyKey    String                   @map("idempotency_key")
  requestFingerprint String                  @map("request_fingerprint")
  lastErrorCode     String?                  @map("last_error_code")
  createdAt         DateTime                 @default(now()) @map("created_at")
  updatedAt         DateTime                 @updatedAt @map("updated_at")
  completedAt       DateTime?                @map("completed_at")
  calls             BookingSupplierCall[]

  @@unique([tenantId, bookingId, idempotencyKey])
  @@index([tenantId, status, runAfter])
  @@index([tenantId, bookingId, createdAt])
}

/// Append-only log of supplier calls: a summary, never a raw request or response (CLAUDE.md invariant 7).
model BookingSupplierCall {
  id                String                 @id @default(cuid())
  tenantId          String                 @map("tenant_id")
  tenant            Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  bookingId         String                 @map("booking_id")
  booking           Booking                @relation(fields: [tenantId, bookingId], references: [tenantId, id], onDelete: Cascade)
  jobId             String?                @map("job_id")
  job               BookingSupplierJob?    @relation(fields: [jobId], references: [id], onDelete: SetNull)
  action            BookingSupplierJobKind
  attempt           Int
  supplierKey       String                 @map("supplier_key")
  outcome           String
  errorCode         String?                @map("error_code")
  httpStatus        Int?                   @map("http_status")
  durationMs        Int?                   @map("duration_ms")
  supplierReference String?                @map("supplier_reference")
  createdAt         DateTime               @default(now()) @map("created_at")

  @@index([tenantId, bookingId, createdAt])
}

model BookingEvent {
  id         String           @id @default(cuid())
  tenantId   String           @map("tenant_id")
  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  bookingId  String           @map("booking_id")
  booking    Booking          @relation(fields: [tenantId, bookingId], references: [tenantId, id], onDelete: Cascade)
  fromStatus BookingStatus?   @map("from_status")
  toStatus   BookingStatus    @map("to_status")
  actorType  BookingActorType @map("actor_type")
  actorId    String?          @map("actor_id")
  reason     String?
  payload    Json             @default("{}")
  /// The named lifecycle action that made the change (Phase 2). Null on rows written earlier.
  action             String?  @map("action")
  idempotencyKey     String?  @map("idempotency_key")
  requestFingerprint String?  @map("request_fingerprint")
  createdAt  DateTime         @default(now()) @map("created_at")

  @@unique([tenantId, bookingId, idempotencyKey])
  @@index([tenantId, bookingId, createdAt])
}


/// Durable record of one logical supplier mutation. Written before the adapter is called
/// and updated with the supplier reference before ordinary booking or audit persistence.
model SupplierMutation {
  id                 String                     @id @default(cuid())
  tenantId           String                     @map("tenant_id")
  tenant             Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  bookingId          String                     @map("booking_id")
  booking            Booking                    @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  holdId             String                     @map("hold_id")
  hold               InventoryHold              @relation(fields: [tenantId, holdId], references: [tenantId, id], onDelete: Restrict)
  supplierKey        String                     @map("supplier_key")
  operation          SupplierMutationOperation
  idempotencyKey     String                     @map("idempotency_key")
  requestId          String                     @map("request_id")
  status             SupplierMutationStatus
  attemptedAt        DateTime?                  @map("attempted_at")
  acknowledgedAt     DateTime?                  @map("acknowledged_at")
  resolvedAt         DateTime?                  @map("resolved_at")
  supplierReference  String?                    @map("supplier_reference")
  supplierStatus     String?                    @map("supplier_status")
  requestFingerprint String                     @map("request_fingerprint")
  failureCategory    String?                    @map("failure_category")
  failureCode        String?                    @map("failure_code")
  createdAt          DateTime                   @default(now()) @map("created_at")
  updatedAt          DateTime                   @updatedAt @map("updated_at")

  @@unique([tenantId, bookingId, operation, idempotencyKey])
  @@index([tenantId, status])
  @@index([tenantId, bookingId])
  @@index([tenantId, holdId])
}

model BookingDocument {
  id        String              @id @default(cuid())
  tenantId  String              @map("tenant_id")
  tenant    Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  bookingId String              @map("booking_id")
  booking   Booking             @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  type      BookingDocumentType
  number    String
  payload   Json
  issuedAt  DateTime            @default(now()) @map("issued_at")

  @@unique([bookingId, type])
  @@unique([tenantId, number])
  @@index([tenantId, bookingId])
}

model Cancellation {
  id          String   @id @default(cuid())
  bookingId   String   @map("booking_id")
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  reason      String?
  refundMinor BigInt?  @map("refund_minor")
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([bookingId])
}

/// An account (ADR 0028). `agencyId` null is the tenant HOUSE account (one per tenant and currency, enforced by the partial unique index
/// "Wallet_house_tenant_id_currency_key" in migration 202610210001, which Prisma cannot declare). A set `agencyId` is that agency's account.
/// Slice 1 is read-only: no code path creates agency accounts or posts to them yet; holds and bookings use the house account.
/// Funding receipts (ADR 0028 slice 2): DECLARED -> VERIFIED -> POSTED, or REJECTED. Only POSTED moves money.
enum FundingReceiptStatus {
  DECLARED
  VERIFIED
  POSTED
  REJECTED
}

enum FundingMethod {
  BANK_TRANSFER
  CASH_DEPOSIT
}

enum FundingPayerType {
  AGENCY
  THIRD_PARTY
}

enum FundingChannel {
  ADMIN
  AGENT
}

/// A declared incoming payment for one agency. A declared or verified receipt adds nothing to any balance; posting credits the agency's
/// account (opening it if needed) with one append-only CREDIT. Separation of duties is enforced by the service AND by CHECK constraints in
/// migration 202610220001: the verifier, the compliance reviewer and the poster each differ from the declarer, and above the second-approval
/// threshold the poster also differs from the verifier. One live receipt per (tenant, bank reference, amount, currency) is a partial unique
/// index there (REJECTED receipts do not block a corrected declaration). User ids are plain text so history survives user removal.
model FundingReceipt {
  id                       String               @id @default(cuid())
  tenantId                 String               @map("tenant_id")
  tenant                   Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  agencyId                 String               @map("agency_id")
  agency                   Agency               @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  currency                 String               @db.Char(3)
  amountMinor              BigInt               @map("amount_minor")
  method                   FundingMethod
  bankReference            String               @map("bank_reference")
  valueDate                DateTime             @map("value_date") @db.Date
  payerName                String               @map("payer_name")
  payerType                FundingPayerType     @map("payer_type")
  notes                    String?
  complianceReviewRequired Boolean              @map("compliance_review_required")
  secondApprovalRequired   Boolean              @map("second_approval_required")
  status                   FundingReceiptStatus @default(DECLARED)
  channel                  FundingChannel
  requestId                String               @map("request_id")
  declaredById             String               @map("declared_by_id")
  verifiedById             String?              @map("verified_by_id")
  verifiedAt               DateTime?            @map("verified_at")
  verificationNote         String?              @map("verification_note")
  complianceClearedById    String?              @map("compliance_cleared_by_id")
  complianceClearedAt      DateTime?            @map("compliance_cleared_at")
  complianceNote           String?              @map("compliance_note")
  postedById               String?              @map("posted_by_id")
  postedAt                 DateTime?            @map("posted_at")
  rejectedById             String?              @map("rejected_by_id")
  rejectedAt               DateTime?            @map("rejected_at")
  rejectionReason          String?              @map("rejection_reason")
  walletId                 String?              @map("wallet_id")
  wallet                   Wallet?              @relation(fields: [walletId], references: [id], onDelete: Restrict)
  ledgerEntryId            String?              @unique @map("ledger_entry_id")
  ledgerEntry              LedgerEntry?         @relation(fields: [ledgerEntryId], references: [id], onDelete: Restrict)
  createdAt                DateTime             @default(now()) @map("created_at")
  updatedAt                DateTime             @updatedAt @map("updated_at")

  @@unique([tenantId, requestId])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, agencyId, createdAt])
  @@index([tenantId, bankReference])
}

model Wallet {
  id          String        @id @default(cuid())
  tenantId    String        @map("tenant_id")
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agencyId    String?       @map("agency_id")
  agency      Agency?       @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  currency    String        @default("USD") @db.Char(3)
  creditLimit BigInt        @default(0) @map("credit_limit")
  cachedBalance BigInt      @default(0) @map("cached_balance")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  entries     LedgerEntry[]
  fundingReceipts FundingReceipt[]

  @@unique([tenantId, agencyId, currency])
  @@index([tenantId])
}

model LedgerEntry {
  id          String          @id @default(cuid())
  tenantId    String          @map("tenant_id")
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  walletId    String          @map("wallet_id")
  wallet      Wallet          @relation(fields: [walletId], references: [id], onDelete: Restrict)
  type        LedgerEntryType
  amountMinor BigInt          @map("amount_minor")
  currency    String          @db.Char(3)
  reference   String?
  idempotencyKey String       @map("idempotency_key")
  immutableAt DateTime        @default(now()) @map("immutable_at")
  fundingReceipt FundingReceipt?

  @@index([tenantId, immutableAt])
  @@unique([walletId, idempotencyKey])
}

model AuditEvent {
  id         String         @id @default(cuid())
  tenantId   String?        @map("tenant_id")
  tenant     Tenant?        @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  userId     String?        @map("user_id")
  user       User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  actorType  AuditActorType @map("actor_type")
  action     String
  entityType String         @map("entity_type")
  entityId   String         @map("entity_id")
  payload    Json
  createdAt  DateTime       @default(now()) @map("created_at")

  @@index([tenantId, createdAt])
  @@index([entityType, entityId])
}

/// Tenant-owned commercial source. Credential material is never persisted here.
model Supplier {
  sandboxRuns SandboxContentRun[]
  sandboxLeases SandboxContentLease[]
  inventoryPools InventoryPool[]
  serviceCases ServiceCase[]
  distributionRestrictions DistributionRestriction[]
  markupRules CommercialMarkupRule[]
  id              String         @id @default(cuid())
  tenantId        String         @map("tenant_id")
  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type            SupplierType
  status          SupplierStatus @default(DRAFT)
  legalName       String         @map("legal_name")
  displayName     String         @map("display_name")
  countryCode     String         @db.Char(2) @map("country_code")
  defaultCurrency String         @db.Char(3) @map("default_currency")
  contactMetadata Json           @default("{}") @map("contact_metadata")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  mappings       SupplierHotelMapping[]
  contracts      Contract[]
  connectors     ConnectorDefinition[]
  inventoryEvents InventoryUpdateEvent[]
  memberships    SupplierMembership[]
  roomDrafts     SupplierRoomDraft[]

  @@unique([tenantId, legalName])
  @@unique([tenantId, id])
  @@index([tenantId, status])
  @@index([tenantId, countryCode])
}

/// Canonical fBeds property identity, deliberately separate from supplier IDs.
model Hotel {
  inventoryPools InventoryPool[]
  serviceCases ServiceCase[]
  distributionRestrictions DistributionRestriction[]
  markupRules CommercialMarkupRule[]
  profile HotelProfile?
  externalIdentifiers HotelExternalIdentifier[]
  amenities HotelAmenity[]
  images HotelImage[]
  id            String        @id @default(cuid())
  tenantId      String        @map("tenant_id")
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name          String
  propertyType  String        @map("property_type")
  starRating    Int?          @map("star_rating")
  address       String?
  city          String
  countryCode   String        @db.Char(2) @map("country_code")
  latitude      Decimal?      @db.Decimal(9, 6)
  longitude     Decimal?      @db.Decimal(9, 6)
  timeZone      String        @default("Asia/Dubai") @map("time_zone")
  contentStatus ContentStatus @default(DRAFT) @map("content_status")
  externalRef   String?       @map("external_ref")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  roomTypes RoomType[]
  mappings  SupplierHotelMapping[]
  searchIndex HotelSearchIndex?
  supplierRoomDrafts SupplierRoomDraft[]

  @@unique([tenantId, externalRef])
  @@unique([tenantId, id])
  @@index([tenantId, countryCode, city])
  @@index([tenantId, contentStatus])
}

/// Operational and descriptive hotel content (ADR 0021). One row per canonical hotel, created lazily by the first save.
/// Optimistic concurrency: `version` starts at 1 and increases by one on every save. Contacts are private: no Agent,
/// Website or supplier API reads this table. Actor ids are plain identifiers (no foreign key) so history survives user removal.
model HotelProfile {
  id        String @id @default(cuid())
  tenantId  String @map("tenant_id")
  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  hotelId   String @unique @map("hotel_id")
  hotel     Hotel  @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  legalName        String?  @map("legal_name")
  chainName        String?  @map("chain_name")
  brandName        String?  @map("brand_name")
  area             String?
  postalCode       String?  @map("postal_code")
  shortDescription String?  @map("short_description")
  fullDescription  String?  @map("full_description")
  languages        String[] @default([])
  checkInTime      String?  @map("check_in_time") @db.Char(5)
  checkOutTime     String?  @map("check_out_time") @db.Char(5)
  operationalNotes String?  @map("operational_notes")
  /// Private reservations, commercial, finance and emergency contacts. Never returned by Agent or public APIs.
  contacts         Json     @default("{}")
  /// Hotel-level information only (children, extra beds, pets, accessibility, local charges). Never rate cancellation terms.
  policies         Json     @default("{}")
  sourceSystem     String?  @map("source_system")
  ownerUserId      String?  @map("owner_user_id")
  starSource       String?  @map("star_source")
  starVerifiedAt   DateTime? @map("star_verified_at")
  starVerifiedById String?  @map("star_verified_by_id")
  approvedById     String?  @map("approved_by_id")
  approvedAt       DateTime? @map("approved_at")
  version          Int      @default(1)
  updatedById      String   @map("updated_by_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@index([tenantId, hotelId])
}

/// External hotel identifiers (for example GIATA), stored apart from the canonical id. One value per scheme per hotel,
/// and a value identifies at most one hotel per tenant and scheme.
model HotelExternalIdentifier {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  hotelId     String   @map("hotel_id")
  hotel       Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  scheme      String
  value       String
  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([tenantId, scheme, value])
  @@unique([hotelId, scheme])
  @@index([tenantId, hotelId])
}

enum AmenityFeeType {
  FREE
  PAID
  UNKNOWN
}

/// A hotel-level amenity selected from the controlled catalogue (`@bedbanks/contracts` HOTEL_AMENITY_CATALOGUE). A row means the
/// amenity was recorded for the hotel; no row means nothing is recorded, never "absent". `feeType` UNKNOWN is an explicit answer.
model HotelAmenity {
  id          String         @id @default(cuid())
  tenantId    String         @map("tenant_id")
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  hotelId     String         @map("hotel_id")
  hotel       Hotel          @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  code        String
  feeType     AmenityFeeType @default(UNKNOWN) @map("fee_type")
  updatedById String         @map("updated_by_id")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  @@unique([hotelId, code])
  @@index([tenantId, hotelId])
}

/// A room-level amenity. The composite foreign key keeps the room inside the hotel the row names.
model RoomAmenity {
  id          String         @id @default(cuid())
  tenantId    String         @map("tenant_id")
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  hotelId     String         @map("hotel_id")
  roomTypeId  String         @map("room_type_id")
  roomType    RoomType       @relation(fields: [hotelId, roomTypeId], references: [hotelId, id], onDelete: Cascade)
  code        String
  feeType     AmenityFeeType @default(UNKNOWN) @map("fee_type")
  updatedById String         @map("updated_by_id")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  @@unique([roomTypeId, code])
  @@index([tenantId, hotelId])
}

/// Normalized identity used only to propose canonical hotel candidates.
/// Embeddings are a retrieval signal. They never approve a mapping by themselves.
model HotelSearchIndex {
  id                     String   @id @default(cuid())
  tenantId               String   @map("tenant_id")
  tenant                 Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  hotelId                String   @map("hotel_id")
  hotel                  Hotel    @relation(fields: [tenantId, hotelId], references: [tenantId, id], onDelete: Cascade)
  normalizedName         String   @map("normalized_name")
  normalizedAddress      String   @map("normalized_address")
  normalizedCity         String   @map("normalized_city")
  normalizedCountryCode  String   @db.Char(2) @map("normalized_country_code")
  latitude               Decimal? @db.Decimal(9, 6)
  longitude              Decimal? @db.Decimal(9, 6)
  embedding              Unsupported("vector(64)")
  embeddingModel         String   @map("embedding_model")
  updatedAt              DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, hotelId])
  @@index([tenantId, normalizedCountryCode, normalizedCity])
  @@index([normalizedName(ops: raw("gin_trgm_ops"))], type: Gin, map: "HotelSearchIndex_name_trgm")
  @@index([normalizedAddress(ops: raw("gin_trgm_ops"))], type: Gin, map: "HotelSearchIndex_address_trgm")
}

model RoomType {
  id          String   @id @default(cuid())
  hotelId     String   @map("hotel_id")
  hotel       Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  name        String
  code        String
  maxAdults   Int      @map("max_adults")
  maxChildren Int      @default(0) @map("max_children")
  maxOccupancy Int     @map("max_occupancy")
  beddingMetadata Json @default("{}") @map("bedding_metadata")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  ratePlans RatePlan[]
  supplierRoomMappings SupplierRoomMapping[]
  supplierRoomDrafts SupplierRoomDraft[]
  amenities RoomAmenity[]

  @@unique([hotelId, code])
  @@unique([hotelId, id])
  @@index([hotelId, isActive])
}

model BoardBasis {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code        String   @db.Char(3)
  name        String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  ratePlans RatePlan[]

  @@unique([tenantId, code])
  @@index([tenantId, isActive])
}

model SupplierHotelMapping {
  id               String        @id @default(cuid())
  tenantId         String        @map("tenant_id")
  supplierId       String        @map("supplier_id")
  supplier         Supplier      @relation(fields: [tenantId, supplierId], references: [tenantId, id], onDelete: Cascade)
  hotelId          String        @map("hotel_id")
  hotel            Hotel         @relation(fields: [tenantId, hotelId], references: [tenantId, id], onDelete: Cascade)
  supplierHotelId  String        @map("supplier_hotel_id")
  status           MappingStatus @default(PENDING)
  confidence       Int?          @map("confidence")
  sourceMetadata   Json          @default("{}") @map("source_metadata")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  contracts Contract[]
  roomMappings SupplierRoomMapping[]

  @@unique([supplierId, supplierHotelId])
  @@unique([supplierId, hotelId])
  @@unique([tenantId, id, hotelId])
  @@index([tenantId, status])
  @@index([hotelId])
}

/// Supplier room identity is scoped by its parent mapping. hotelId is retained
/// solely so PostgreSQL can enforce both the parent and RoomType hotel match.
model SupplierRoomMapping {
  id String @id @default(cuid())
  tenantId String @map("tenant_id")
  supplierHotelMappingId String @map("supplier_hotel_mapping_id")
  hotelId String @map("hotel_id")
  supplierRoomId String @map("supplier_room_id")
  roomTypeId String @map("room_type_id")
  status MappingStatus @default(PENDING)
  confidence Int? @map("confidence")
  sourceMetadata Json @default("{}") @map("source_metadata")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  supplierHotelMapping SupplierHotelMapping @relation(fields: [tenantId, supplierHotelMappingId, hotelId], references: [tenantId, id, hotelId], onDelete: Cascade)
  roomType RoomType @relation(fields: [hotelId, roomTypeId], references: [hotelId, id], onDelete: Restrict)

  @@unique([supplierHotelMappingId, supplierRoomId])
  @@index([tenantId, status])
  @@index([hotelId, roomTypeId])
}

/// Authenticated user membership in one tenant-owned supplier organization.
/// Admin supply permissions do not create this row.
model SupplierMembership {
  id         String                   @id @default(cuid())
  tenantId   String                   @map("tenant_id")
  tenant     Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId     String                   @map("user_id")
  user       User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  supplierId String                   @map("supplier_id")
  supplier   Supplier                 @relation(fields: [tenantId, supplierId], references: [tenantId, id], onDelete: Cascade)
  status     SupplierMembershipStatus @default(ACTIVE)
  createdAt  DateTime                 @default(now()) @map("created_at")
  updatedAt  DateTime                 @updatedAt @map("updated_at")

  @@unique([userId, tenantId, supplierId])
  @@index([tenantId, userId, status])
  @@index([tenantId, supplierId])
  @@map("supplier_memberships")
}

/// Private supplier note for a mapped room. It is not room content, a rate, or availability,
/// and it cannot be published or activated.
model SupplierRoomDraft {
  id            String   @id @default(cuid())
  tenantId      String   @map("tenant_id")
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplierId    String   @map("supplier_id")
  supplier      Supplier @relation(fields: [tenantId, supplierId], references: [tenantId, id], onDelete: Cascade)
  hotelId       String   @map("hotel_id")
  hotel         Hotel    @relation(fields: [tenantId, hotelId], references: [tenantId, id], onDelete: Cascade)
  roomTypeId    String   @map("room_type_id")
  roomType      RoomType @relation(fields: [hotelId, roomTypeId], references: [hotelId, id], onDelete: Restrict)
  supplierNotes String   @map("supplier_notes") @db.VarChar(500)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, supplierId, roomTypeId])
  @@index([tenantId, supplierId, hotelId])
  @@map("supplier_room_drafts")
}

model Contract {
  id                  String         @id @default(cuid())
  tenantId            String         @map("tenant_id")
  tenant              Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplierId          String         @map("supplier_id")
  supplier            Supplier       @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  supplierHotelMappingId String?     @map("supplier_hotel_mapping_id")
  supplierHotelMapping SupplierHotelMapping? @relation(fields: [supplierHotelMappingId], references: [id], onDelete: Restrict)
  code                String
  status              ContractStatus @default(DRAFT)
  validFrom           DateTime       @map("valid_from") @db.Date
  validTo             DateTime       @map("valid_to") @db.Date
  settlementCurrency  String         @db.Char(3) @map("settlement_currency")
  salesMarkets        Json           @default("[]") @map("sales_markets")
  nationalities       Json           @default("[]")
  paymentPolicyRef    String?        @map("payment_policy_ref")
  sourceMetadata      Json           @default("{}") @map("source_metadata")
  version             Int            @default(1)
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")

  ratePlans             RatePlan[]
  cancellationPolicies  CancellationPolicy[]
  childPolicies         ChildPolicy[]
  leadTimeRules         BookingLeadTimeRule[]

  @@unique([tenantId, code, version])
  @@index([tenantId, status, validFrom, validTo])
  @@index([supplierId, status])
}

model RatePlan {
  id                String         @id @default(cuid())
  tenantId          String         @map("tenant_id")
  contractId        String         @map("contract_id")
  contract          Contract       @relation(fields: [contractId], references: [id], onDelete: Cascade)
  roomTypeId        String         @map("room_type_id")
  roomType          RoomType       @relation(fields: [roomTypeId], references: [id], onDelete: Restrict)
  boardBasisId      String         @map("board_basis_id")
  boardBasis        BoardBasis     @relation(fields: [boardBasisId], references: [id], onDelete: Restrict)
  code              String
  status            RatePlanStatus @default(DRAFT)
  refundable        Boolean        @default(true)
  occupancy         Int
  currency          String         @db.Char(3)
  taxesIncluded     Boolean        @default(false) @map("taxes_included")
  feesIncluded      Boolean        @default(false) @map("fees_included")
  minStay           Int            @default(1) @map("min_stay")
  maxStay           Int?           @map("max_stay")
  releaseDays       Int            @default(0) @map("release_days")
  /// Hotel-local time of day (HH:MM) at which the release deadline falls, `releaseDays` before the check-in date (ADR 0030).
  releaseTimeLocal  String         @default("00:00") @map("release_time_local") @db.Char(5)
  /// The shared physical stock this plan draws from, if any. Pools never mix tenants, hotels or suppliers (database trigger).
  inventoryPoolId   String?        @map("inventory_pool_id")
  inventoryPool     InventoryPool? @relation(fields: [tenantId, inventoryPoolId], references: [tenantId, id], onDelete: Restrict)
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  availability DailyAvailability[]
  dailyRates   DailyRate[]

  @@unique([contractId, code])
  @@index([tenantId, status])
  @@index([roomTypeId])
  @@index([tenantId, inventoryPoolId])
}

model CancellationPolicy {
  id              String   @id @default(cuid())
  contractId      String   @map("contract_id")
  contract        Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  daysBeforeCheckin Int    @map("days_before_checkin")
  penaltyPercent  Int?     @map("penalty_percent")
  penaltyMinor    BigInt?  @map("penalty_minor")
  currency        String?  @db.Char(3)
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([contractId])
}

model ChildPolicy {
  id             String   @id @default(cuid())
  contractId     String   @map("contract_id")
  contract       Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  minAge         Int      @map("min_age")
  maxAge         Int      @map("max_age")
  extraBedAllowed Boolean @default(false) @map("extra_bed_allowed")
  supplementMinor BigInt? @map("supplement_minor")
  currency       String?  @db.Char(3)
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([contractId])
}

model BookingLeadTimeRule {
  id            String   @id @default(cuid())
  contractId    String   @map("contract_id")
  contract      Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  minLeadHours  Int      @default(0) @map("min_lead_hours")
  maxLeadDays   Int?     @map("max_lead_days")
  createdAt     DateTime @default(now()) @map("created_at")

  @@unique([contractId])
}

/// A shared physical stock of rooms for one hotel and one supplier (ADR 0030). Rate plans that belong to the pool draw from the same
/// daily counters, so three plans over five rooms are five rooms, not fifteen.
model InventoryPool {
  id          String              @id @default(cuid())
  tenantId    String              @map("tenant_id")
  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  hotelId     String              @map("hotel_id")
  hotel       Hotel               @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  supplierId  String              @map("supplier_id")
  supplier    Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  name        String
  status      InventoryPoolStatus @default(ACTIVE)
  createdById String              @map("created_by_id")
  archivedAt  DateTime?           @map("archived_at")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  days  InventoryPoolDay[]
  plans RatePlan[]

  @@unique([tenantId, id])
  @@unique([tenantId, hotelId, supplierId, name])
  @@index([tenantId, hotelId])
}

/// One night of a pool's physical stock. `sold + held <= capacity` is a database constraint.
model InventoryPoolDay {
  id              String          @id @default(cuid())
  tenantId        String          @map("tenant_id")
  poolId          String          @map("pool_id")
  pool            InventoryPool   @relation(fields: [tenantId, poolId], references: [tenantId, id], onDelete: Restrict)
  stayDate        DateTime        @map("stay_date") @db.Date
  capacity        Int
  sold            Int             @default(0)
  held            Int             @default(0)
  source          InventorySource @default(ADMIN)
  sourceUpdatedAt DateTime?       @map("source_updated_at")
  receivedAt      DateTime        @default(now()) @map("received_at")
  freshUntil      DateTime?       @map("fresh_until")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  holdNights InventoryHoldNight[]

  @@unique([poolId, stayDate])
  @@unique([tenantId, id])
  @@index([tenantId, stayDate])
}

model DailyAvailability {
  id                 String   @id @default(cuid())
  tenantId           String   @map("tenant_id")
  ratePlanId         String   @map("rate_plan_id")
  ratePlan           RatePlan @relation(fields: [ratePlanId], references: [id], onDelete: Cascade)
  stayDate           DateTime @map("stay_date") @db.Date
  allotment          Int
  sold               Int      @default(0)
  held               Int      @default(0)
  stopSell           Boolean  @default(false) @map("stop_sell")
  minStay            Int      @default(1) @map("min_stay")
  closedToArrival    Boolean  @default(false) @map("closed_to_arrival")
  closedToDeparture  Boolean  @default(false) @map("closed_to_departure")
  /// ALLOTMENT uses the plan row's counters, or the pool day when the plan belongs to a pool. FREE_SALE needs no stock. ON_REQUEST is never instant. CLOSED is never sold.
  inventoryMode      InventoryMode @default(ALLOTMENT) @map("inventory_mode")
  source             InventorySource @default(ADMIN)
  sourceUpdatedAt    DateTime? @map("source_updated_at")
  receivedAt         DateTime  @default(now()) @map("received_at")
  /// After this instant the row is stale and fails closed. Null means it does not expire, except for supplier sources, which then count as stale.
  freshUntil         DateTime? @map("fresh_until")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  holdNights         InventoryHoldNight[]

  @@unique([ratePlanId, stayDate])
  @@unique([tenantId, id])
  @@index([tenantId, stayDate])
}

model InventoryHold {
  id                 String              @id @default(cuid())
  tenantId           String              @map("tenant_id")
  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  ratePlanId         String              @map("rate_plan_id")
  offerId            String              @map("offer_id")
  searchId           String              @map("search_id")
  canonicalHotelId   String              @map("canonical_hotel_id")
  canonicalRoomTypeId String             @map("canonical_room_type_id")
  boardBasisId       String              @map("board_basis_id")
  checkIn            DateTime            @map("check_in") @db.Date
  checkOut           DateTime            @map("check_out") @db.Date
  rooms              Int
  currency           String              @db.Char(3)
  sellAmountMinor    BigInt              @map("sell_amount_minor")
  idempotencyKey     String              @map("idempotency_key")
  requestFingerprint String              @map("request_fingerprint")
  requestId          String              @map("request_id")
  createdByUserId    String              @map("created_by_user_id")
  status             InventoryHoldStatus @default(HOLD_PENDING)
  expiresAt          DateTime            @map("expires_at")
  releasedAt         DateTime?           @map("released_at")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  nights             InventoryHoldNight[]
  supplierMutations  SupplierMutation[]

  @@unique([tenantId, idempotencyKey])
  @@unique([tenantId, id])
  @@index([tenantId, status, expiresAt])
  @@index([tenantId, createdByUserId, status])
  @@index([tenantId, ratePlanId, checkIn, checkOut])
}

model InventoryHoldNight {
  id             String            @id @default(cuid())
  tenantId       String            @map("tenant_id")
  holdId         String            @map("hold_id")
  hold           InventoryHold     @relation(fields: [tenantId, holdId], references: [tenantId, id], onDelete: Cascade)
  availabilityId String            @map("availability_id")
  availability   DailyAvailability @relation(fields: [tenantId, availabilityId], references: [tenantId, id], onDelete: Restrict)
  stayDate       DateTime          @map("stay_date") @db.Date
  quantity       Int
  counterKind    InventoryCounterKind @default(PLAN_ROW) @map("counter_kind")
  poolDayId      String?           @map("pool_day_id")
  poolDay        InventoryPoolDay? @relation(fields: [tenantId, poolDayId], references: [tenantId, id], onDelete: Restrict)
  createdAt      DateTime          @default(now()) @map("created_at")

  @@unique([holdId, availabilityId])
  @@index([tenantId, stayDate])
}

model DailyRate {
  id             String   @id @default(cuid())
  tenantId       String   @map("tenant_id")
  ratePlanId     String   @map("rate_plan_id")
  ratePlan       RatePlan @relation(fields: [ratePlanId], references: [id], onDelete: Cascade)
  stayDate       DateTime @map("stay_date") @db.Date
  occupancy      Int
  amountMinor    BigInt   @map("amount_minor")
  amountBasis    RateAmountBasis? @map("amount_basis")
  currency       String   @db.Char(3)
  taxMetadata    Json     @default("{}") @map("tax_metadata")
  feeMetadata    Json     @default("{}") @map("fee_metadata")
  sourceVersion  String?  @map("source_version")
  sourceUpdatedAt DateTime? @map("source_updated_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([ratePlanId, stayDate, occupancy])
  @@index([tenantId, stayDate])
  @@index([tenantId, amountBasis, stayDate])
}

model ConnectorDefinition {
  sandboxRuns SandboxContentRun[]
  sandboxLeases SandboxContentLease[]
  id                  String          @id @default(cuid())
  tenantId            String          @map("tenant_id")
  tenant              Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplierId          String          @map("supplier_id")
  supplier            Supplier        @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  type                ConnectorType
  status              ConnectorStatus @default(DRAFT)
  name                String
  capabilities        Json            @default("[]")
  transportMetadata   Json            @default("{}") @map("transport_metadata")
  version             String
  healthState         String          @default("unknown") @map("health_state")
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")

  credentialReferences ConnectorCredentialReference[]
  executions           ConnectorExecution[]
  inventoryEvents      InventoryUpdateEvent[]

  @@unique([supplierId, name])
  @@unique([tenantId, id, supplierId])
  @@index([tenantId, status])
}

/// Stores an approved secret-manager reference only, never secret material.
model ConnectorCredentialReference {
  id          String              @id @default(cuid())
  connectorId String              @map("connector_id")
  connector   ConnectorDefinition @relation(fields: [connectorId], references: [id], onDelete: Cascade)
  secretRef   String              @map("secret_ref")
  purpose     String
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  @@unique([connectorId, purpose])
}

model ConnectorExecution {
  id                  String                   @id @default(cuid())
  tenantId            String                   @map("tenant_id")
  connectorId         String                   @map("connector_id")
  connector           ConnectorDefinition      @relation(fields: [connectorId], references: [id], onDelete: Cascade)
  correlationId       String                   @map("correlation_id")
  operation           String
  status              ConnectorExecutionStatus @default(RECEIVED)
  latencyMs           Int?                     @map("latency_ms")
  retryCount          Int                      @default(0) @map("retry_count")
  errorClassification String?                  @map("error_classification")
  createdAt           DateTime                 @default(now()) @map("created_at")
  updatedAt           DateTime                 @updatedAt @map("updated_at")

  @@unique([connectorId, correlationId])
  @@index([tenantId, createdAt])
}

model InventoryUpdateEvent {
  id                String              @id @default(cuid())
  tenantId          String              @map("tenant_id")
  tenant            Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplierId        String              @map("supplier_id")
  supplier          Supplier            @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  connectorId       String?             @map("connector_id")
  connector         ConnectorDefinition? @relation(fields: [connectorId], references: [id], onDelete: SetNull)
  idempotencyKey    String              @map("idempotency_key")
  outcome           ConnectorExecutionStatus @default(RECEIVED)
  validationErrors  Json                @default("[]") @map("validation_errors")
  receivedAt        DateTime            @default(now()) @map("received_at")
  processedAt       DateTime?           @map("processed_at")

  @@unique([supplierId, idempotencyKey])
  @@index([tenantId, receivedAt])
}

/// Quarantined supplier SANDBOX content only; never canonical mapping or inventory.
model SandboxContentRun {
  id String @id
  tenantId String @map("tenant_id")
  supplierId String @map("supplier_id")
  connectorId String @map("connector_id")
  parameterHash String @map("parameter_hash") @db.Char(64)
  lastUpdateTime String? @map("last_update_time") @db.Char(10)
  nextFrom Int @default(1) @map("next_from")
  status String @default("PENDING")
  attemptCount Int @default(0) @map("attempt_count")
  pageCount Int @default(0) @map("page_count")
  lastAttemptAt DateTime? @map("last_attempt_at")
  lastSuccessAt DateTime? @map("last_success_at")
  errorClassification String? @map("error_classification")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  connector ConnectorDefinition @relation(fields: [tenantId, connectorId, supplierId], references: [tenantId, id, supplierId], onDelete: Restrict)
  supplier Supplier @relation(fields: [tenantId, supplierId], references: [tenantId, id], onDelete: Restrict)
  pages SandboxContentPage[]
  @@unique([tenantId, id])
  @@index([tenantId, connectorId, createdAt])
}

model SandboxContentPage {
  id String @id
  tenantId String @map("tenant_id")
  runId String @map("run_id")
  from Int
  nextFrom Int @map("next_from")
  payloadHash String @map("payload_hash") @db.Char(64)
  hotels Json
  receivedAt DateTime @map("received_at")
  createdAt DateTime @default(now()) @map("created_at")
  run SandboxContentRun @relation(fields: [tenantId, runId], references: [tenantId, id], onDelete: Restrict)
  @@unique([runId, from])
  @@index([tenantId, runId])
}

model SandboxContentLease {
  tenantId String @map("tenant_id")
  supplierId String @map("supplier_id")
  connectorId String @map("connector_id")
  token String?
  expiresAt DateTime? @map("expires_at")
  generation Int @default(0)
  connector ConnectorDefinition @relation(fields: [tenantId, connectorId, supplierId], references: [tenantId, id, supplierId], onDelete: Restrict)
  supplier Supplier @relation(fields: [tenantId, supplierId], references: [tenantId, id], onDelete: Restrict)
  @@id([tenantId, connectorId])
}
