{
  "name": "@bedbanks/api",
  "version": "0.1.0",
  "description": "FBEDS API — NestJS backend foundation (P0-B)",
  "private": true,
  "scripts": {
    "dev": "node --no-experimental-strip-types -r @swc-node/register src/main.ts",
    "build": "nest build",
    "start": "node --no-experimental-strip-types -r @swc-node/register src/main.ts",
    "start:prod": "node --no-experimental-strip-types -r @swc-node/register src/main.ts",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "pnpm run test:unit && pnpm run test:e2e",
    "test:unit": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "prisma:generate": "prisma generate --schema=prisma/schema.prisma",
    "prisma:migrate:dev": "prisma migrate dev --schema=prisma/schema.prisma",
    "prisma:migrate:deploy": "prisma migrate deploy --schema=prisma/schema.prisma",
    "prisma:migrate:status": "prisma migrate status --schema=prisma/schema.prisma",
    "prisma:migrate:drift": "node scripts/check-migration-drift.mjs",
    "prisma:studio": "prisma studio --schema=prisma/schema.prisma",
    "db:seed": "prisma db seed --schema=prisma/schema.prisma",
    "ops:provision-hold-expiry-role": "tsx src/database/provision-hold-expiry-role.cli.ts",
    "ops:strict-role-boot-smoke": "node scripts/strict-role-boot-smoke.cjs",
    "ops:render-runtime-role-doc": "tsx src/database/render-runtime-role-doc.cli.ts",
    "ops:provision-api-runtime-role": "node --no-experimental-strip-types -r @swc-node/register src/database/provision-api-runtime-role.cli.ts",
    "ops:strict-role-rollout": "node --no-experimental-strip-types -r @swc-node/register src/database/strict-role-rollout.cli.ts",
    "ops:provision-preview-fixtures": "node --no-experimental-strip-types -r @swc-node/register src/database/provision-preview-fixtures.cli.ts",
    "ops:bootstrap-first-admin": "node --no-experimental-strip-types -r @swc-node/register src/database/bootstrap-first-admin.cli.ts",
    "prisma:validate": "prisma validate --schema=prisma/schema.prisma",
    "test:auth:http": "jest --config ./test/jest-e2e.json --runInBand auth.e2e-spec.ts",
    "test:auth:admin": "jest --config ./test/admin-auth.jest.cjs --runInBand"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@bedbanks/contracts": "workspace:*",
    "@bedbanks/domain": "workspace:*",
    "@bedbanks/money": "workspace:*",
    "@bedbanks/pricing": "workspace:*",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^8.1.0",
    "@prisma/client": "^6.2.1",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.16.13"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.7",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "prisma": "^6.2.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/../test/currency-policy.setup.ts"
    ]
  }
}
